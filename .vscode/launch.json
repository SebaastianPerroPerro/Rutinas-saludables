{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: desarrollo",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx.cmd",
      "runtimeArgs": ["watch", "${workspaceFolder}/src/server.ts"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}